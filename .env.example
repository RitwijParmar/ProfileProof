PROFILEPROOF_ENVIRONMENT=development
PROFILEPROOF_LOG_LEVEL=INFO
PROFILEPROOF_CACHE_TTL_SECONDS=300
PROFILEPROOF_RATE_LIMIT_REQUESTS=60
PROFILEPROOF_RATE_LIMIT_WINDOW_SECONDS=60
PROFILEPROOF_MAX_BODY_BYTES=65536
# Optional: SHA-256 digest of the API key, never the plaintext key.
# PROFILEPROOF_API_KEY_SHA256=
