PROFILEPROOF_ENVIRONMENT=development
PROFILEPROOF_LOG_LEVEL=INFO
PROFILEPROOF_CACHE_TTL_SECONDS=3600
PROFILEPROOF_RATE_LIMIT_REQUESTS=60
PROFILEPROOF_RATE_LIMIT_WINDOW_SECONDS=60
PROFILEPROOF_MAX_BODY_BYTES=65536
# Optional: SHA-256 digest of the API key, never the plaintext key.
# PROFILEPROOF_API_KEY_SHA256=
# Authenticated LinkedIn acquisition. Never commit these session values.
# PROFILEPROOF_LINKEDIN_LI_AT=
# PROFILEPROOF_LINKEDIN_JSESSIONID=
PROFILEPROOF_LINKEDIN_CALLS_PER_INSTANCE_PER_DAY=100
PROFILEPROOF_LINKEDIN_TIMEOUT_SECONDS=10
# Licensed real-profile provider. Store the real key in a secret manager.
# PROFILEPROOF_PDL_API_KEY=
PROFILEPROOF_PDL_MIN_LIKELIHOOD=8
PROFILEPROOF_PDL_CALLS_PER_INSTANCE_PER_DAY=50
PROFILEPROOF_PDL_TIMEOUT_SECONDS=8
